{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "梯队实战机会配置簿领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROFILE_VERSIONED",
        "CLEARANCE_RECORDED",
        "PROPOSAL_SUBMITTED",
        "SLOT_AWARDED",
        "REVIEW_PUBLISHED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "athlete_profile",
        "competition_slot",
        "lineup_proposal",
        "development_gap"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CLEARANCE_RECORDED": [
      "valid_until",
      "scope"
    ],
    "SLOT_AWARDED": [
      "policy_version",
      "slot_ref"
    ],
    "REVIEW_PUBLISHED": [
      "evidence_cutoff",
      "gap_changes"
    ]
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "梯队实战机会配置簿领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROFILE_VERSIONED",
        "CLEARANCE_RECORDED",
        "OBSERVATION_RECORDED",
        "POLICY_PUBLISHED",
        "EVENT_REGISTERED",
        "PROPOSAL_SUBMITTED",
        "DECISION_RECORDED",
        "SLOT_AWARDED",
        "SLOT_RELEASED",
        "APPEARANCE_RECORDED",
        "REVIEW_PUBLISHED",
        "CLOCK_ADVANCED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "athlete_profile",
        "policy",
        "competition_event",
        "lineup_proposal",
        "competition_slot",
        "development_gap",
        "clock"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CLEARANCE_RECORDED": [
      "valid_until",
      "scope"
    ],
    "OBSERVATION_RECORDED": [
      "coach_id",
      "observed_at"
    ],
    "POLICY_PUBLISHED": [
      "policy_version",
      "rules"
    ],
    "EVENT_REGISTERED": [
      "event_level",
      "entry_deadline",
      "slots"
    ],
    "PROPOSAL_SUBMITTED": [
      "event_ref",
      "frozen_policy_version",
      "entries"
    ],
    "DECISION_RECORDED": [
      "decision",
      "decided_by"
    ],
    "SLOT_AWARDED": [
      "policy_version",
      "slot_ref"
    ],
    "SLOT_RELEASED": [
      "slot_ref",
      "reason"
    ],
    "APPEARANCE_RECORDED": [
      "slot_ref",
      "result"
    ],
    "REVIEW_PUBLISHED": [
      "evidence_cutoff",
      "gap_changes"
    ],
    "CLOCK_ADVANCED": [
      "simulated_at"
    ]
  },
  "additionalProperties": false
}
